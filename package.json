{
  "name": "dracula-engine",
  "productName": "Dracula",
  "version": "1.1.0",
  "description": "Dracula: The Resurrection and The Last Sanctuary, risen from the grave.",
  "license": "GPL-3.0-or-later",
  "author": "Gabriel Maranhão <47640024+gabrielmmaranhao@users.noreply.github.com> (https://github.com/gabrielmmaranhao)",
  "main": "dist/app/main.js",
  "desktopName": "dracula.desktop",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carfax-Project/dracula-engine.git"
  },
  "homepage": "https://github.com/Carfax-Project/dracula-engine#readme",
  "bugs": {
    "url": "https://github.com/Carfax-Project/dracula-engine/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/test.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dist": "node scripts/build.mjs --release && electron-builder",
    "test:e2e": "node scripts/build.mjs && node scripts/e2e.mjs",
    "import": "node scripts/build.mjs && node dist/app/import.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.0"
  },
  "build": {
    "appId": "local.dracula.engine",
    "productName": "Dracula",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/app/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "src/renderer/assets/icon.png",
      "syncDesktopName": true,
      "artifactName": "Dracula-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "src/renderer/assets/icon.ico",
      "artifactName": "Dracula-Setup-${version}-${arch}.${ext}"
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "deb": {
      "artifactName": "dracula_${version}_${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
